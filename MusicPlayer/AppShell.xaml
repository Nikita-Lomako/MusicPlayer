<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MusicPlayer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MusicPlayer.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Музыка"
    Shell.TabBarBackgroundColor="{DynamicResource Surface}"
    Shell.TabBarForegroundColor="{DynamicResource Accent}"
    Shell.TabBarUnselectedColor="{DynamicResource TabInactive}">

    <TabBar>
        <ShellContent
            x:Name="LibraryTab"
            Title="Медиатека"
            Icon="library.png"
            ContentTemplate="{DataTemplate views:LibraryPage}"
            Route="library" />

        <ShellContent
            x:Name="PlaylistsTab"
            Title="Плейлисты"
            Icon="playlists.png"
            ContentTemplate="{DataTemplate views:PlaylistsPage}"
            Route="playlists" />

        <ShellContent
            x:Name="HistoryTab"
            Title="Недавнее"
            Icon="history.png"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="history" />

        <ShellContent
            x:Name="SettingsTab"
            Title="Настройки"
            Icon="settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
