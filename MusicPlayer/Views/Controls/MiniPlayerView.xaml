<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             x:Class="MusicPlayer.Views.Controls.MiniPlayerView"
             x:DataType="vm:MiniPlayerViewModel"
             IsVisible="{Binding IsVisible}">
    <Border Padding="12"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="12">
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="2">
                <Label Text="{Binding Title}"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       FontAttributes="Bold" />
                <Label Grid.Row="1"
                       Text="{Binding Artist}"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPlayerCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
            <ImageButton Grid.Column="1"
                         AutomationId="MiniPlayerPlayPauseButton"
                         Source="{Binding PlayPauseIcon}"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Background="Transparent"
                         Command="{Binding TogglePlaybackCommand}"
                         SemanticProperties.Description="{Binding PlayLabel}" />
            <ImageButton Grid.Column="2"
                         AutomationId="MiniPlayerNextButton"
                         Source="next.png"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Background="Transparent"
                         Command="{Binding NextCommand}"
                         SemanticProperties.Description="{Binding NextLabel}" />
        </Grid>
    </Border>
</ContentView>
