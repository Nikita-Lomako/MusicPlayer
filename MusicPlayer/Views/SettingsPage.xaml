<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             x:Class="MusicPlayer.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <Grid Padding="24"
          RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="20">
            <Label Text="{Binding AppearanceSection}"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Picker AutomationId="ThemePicker"
                    Title="{Binding ThemeLabel}"
                    ItemsSource="{Binding ThemeOptions}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}" />
            <Label Text="{Binding LanguageSection}"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Picker AutomationId="LanguagePicker"
                    Title="{Binding LanguageSection}"
                    ItemsSource="{Binding LanguageOptions}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>