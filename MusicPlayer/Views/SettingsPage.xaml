<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             x:Class="MusicPlayer.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="18">
            <Label Text="{Binding AppearanceSection}"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Picker AutomationId="ThemePicker"
                    Title="{Binding ThemeLabel}"
                    ItemsSource="{Binding ThemeOptions}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}" />
            <Picker AutomationId="LanguagePicker"
                    Title="{Binding LanguageSection}"
                    ItemsSource="{Binding LanguageOptions}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}" />

            <BoxView HeightRequest="1"
                     Color="{DynamicResource BorderColor}" />

            <Label Text="{Binding ScanSection}"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Label Text="{Binding FoldersLabel}"
                   FontSize="14"
                   TextColor="{DynamicResource TextSecondary}" />

            <CollectionView AutomationId="ScanFoldersList"
                            ItemsSource="{Binding ScanFolders}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="0,6"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Label Text="{Binding .}"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   LineBreakMode="MiddleTruncation" />
                            <ImageButton Grid.Column="1"
                                         Source="delete.png"
                                         WidthRequest="32"
                                         HeightRequest="32"
                                         Padding="6"
                                         Background="Transparent"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveFolderCommand}"
                                         CommandParameter="{Binding .}"
                                         SemanticProperties.Description="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveFolderLabel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding NoFoldersHint}"
                   IsVisible="{Binding HasFolders, Converter={StaticResource InvertedBoolConverter}}"
                   FontSize="12"
                   TextColor="{DynamicResource TextSecondary}" />

            <HorizontalStackLayout Spacing="10">
                <Button AutomationId="AddFolderButton"
                        Text="{Binding AddFolderLabel}"
                        Command="{Binding AddFolderCommand}" />
                <Button AutomationId="RescanButton"
                        Text="{Binding RescanLabel}"
                        Command="{Binding RescanCommand}" />
                <Button AutomationId="PickFileButton"
                        Text="{Binding PickFileLabel}"
                        Command="{Binding PickFileCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsScanning}"
                               IsVisible="{Binding IsScanning}"
                               HorizontalOptions="Start"
                               Color="{DynamicResource Accent}" />

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   FontSize="13"
                   TextColor="{DynamicResource Accent}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
