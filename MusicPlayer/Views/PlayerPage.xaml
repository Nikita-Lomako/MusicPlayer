<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             x:Class="MusicPlayer.Views.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             Title="{Binding Title}">
    <Grid Padding="20"
          RowDefinitions="*,Auto"
          RowSpacing="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="18"
                                 VerticalOptions="Center">
                <Border WidthRequest="280"
                        HeightRequest="280"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                    <Grid>
                        <Image Source="note.png"
                               WidthRequest="96"
                               HeightRequest="96"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Opacity="0.35" />
                        <Image Source="{Binding ArtworkPath}"
                               Aspect="AspectFill"
                               IsVisible="{Binding HasArtwork}" />
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Artist}"
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{Binding PositionText}"
                           VerticalOptions="Center"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Slider Grid.Column="1"
                            AutomationId="PlayerSeekSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding SeekValue, Mode=TwoWay}" />
                    <Label Grid.Column="2"
                           Text="{Binding DurationText}"
                           VerticalOptions="Center"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10">
                    <Image Grid.Column="0"
                           Source="volume.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           VerticalOptions="Center" />
                    <Slider Grid.Column="1"
                            AutomationId="PlayerVolumeSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}"
                            SemanticProperties.Description="{Binding VolumeLabel}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10"
                      HorizontalOptions="Center">
                    <ImageButton Grid.Column="0"
                                 AutomationId="PlayerShuffleButton"
                                 Source="{Binding ShuffleIcon}"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Padding="10"
                                 Background="Transparent"
                                 Command="{Binding ToggleShuffleCommand}"
                                 SemanticProperties.Description="{Binding ShuffleLabel}" />
                    <ImageButton Grid.Column="1"
                                 AutomationId="PlayerPreviousButton"
                                 Source="previous.png"
                                 WidthRequest="52"
                                 HeightRequest="52"
                                 Padding="10"
                                 Background="Transparent"
                                 Command="{Binding PreviousCommand}"
                                 SemanticProperties.Description="{Binding PreviousLabel}" />
                    <ImageButton Grid.Column="2"
                                 AutomationId="PlayerPlayPauseButton"
                                 Source="{Binding PlayPauseIcon}"
                                 WidthRequest="72"
                                 HeightRequest="72"
                                 Padding="10"
                                 Background="Transparent"
                                 Command="{Binding TogglePlaybackCommand}"
                                 SemanticProperties.Description="{Binding PlayPauseLabel}" />
                    <ImageButton Grid.Column="3"
                                 AutomationId="PlayerNextButton"
                                 Source="next.png"
                                 WidthRequest="52"
                                 HeightRequest="52"
                                 Padding="10"
                                 Background="Transparent"
                                 Command="{Binding NextCommand}"
                                 SemanticProperties.Description="{Binding NextLabel}" />
                    <ImageButton Grid.Column="4"
                                 AutomationId="PlayerRepeatButton"
                                 Source="{Binding RepeatIcon}"
                                 WidthRequest="48"
                                 HeightRequest="48"
                                 Padding="10"
                                 Background="Transparent"
                                 Command="{Binding CycleRepeatCommand}"
                                 SemanticProperties.Description="{Binding RepeatLabel}" />
                </Grid>

                <Button Text="{Binding TrackInfoLabel}"
                        AutomationId="PlayerTrackInfoButton"
                        Command="{Binding OpenDetailsCommand}"
                        IsEnabled="{Binding HasTrack}"
                        HorizontalOptions="Center"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Accent}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
