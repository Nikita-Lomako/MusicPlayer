<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             xmlns:controls="clr-namespace:MusicPlayer.Views.Controls"
             x:Class="MusicPlayer.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{Binding Title}">
    <Grid Padding="16"
          RowDefinitions="*,Auto"
          RowSpacing="12">
        <CollectionView Grid.Row="0"
                        AutomationId="HistoryTrackList"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        SelectionMode="None">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:HistoryGroup">
                    <Label Text="{Binding Title}"
                           FontSize="16"
                           FontAttributes="Bold"
                           Padding="0,12,0,6"
                           TextColor="{DynamicResource Accent}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Border Margin="0,0,0,6"
                            Padding="8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{DynamicResource Surface}">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Artist}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1"
                                         Source="info.png"
                                         WidthRequest="36"
                                         HeightRequest="36"
                                         Padding="8"
                                         Background="Transparent"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=OpenDetailsCommand}"
                                         CommandParameter="{Binding .}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=PlayTrackCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="0"
               Text="{Binding EmptyMessage}"
               IsVisible="{Binding IsEmpty}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="16" />
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{DynamicResource Accent}" />
        <controls:MiniPlayerView Grid.Row="1" />
    </Grid>
</ContentPage>
