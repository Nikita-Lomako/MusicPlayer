<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:MusicPlayer.Models"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             xmlns:controls="clr-namespace:MusicPlayer.Views.Controls"
             x:Class="MusicPlayer.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="{Binding LibraryTitle}">
    <Grid Padding="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="12">
        <toolkit:MediaElement x:Name="PlaybackElement"
                              AutomationId="AudioPlaybackHost"
                              WidthRequest="1"
                              HeightRequest="1"
                              Opacity="0"
                              InputTransparent="True"
                              ShouldAutoPlay="False"
                              ShouldShowPlaybackControls="False" />

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <SearchBar x:Name="SearchInput"
                       AutomationId="LibrarySearch"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="{Binding SearchPlaceholder}"
                       SearchButtonPressed="OnSearchButtonPressed"
                       BackgroundColor="{DynamicResource Surface}"
                       TextColor="{DynamicResource TextPrimary}"
                       PlaceholderColor="{DynamicResource TextSecondary}" />
            <ImageButton Grid.Column="1"
                         AutomationId="RescanLibraryButton"
                         Source="refresh.png"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Background="Transparent"
                         Command="{Binding RescanCommand}"
                         SemanticProperties.Description="{Binding RescanLabel}" />
            <ImageButton Grid.Column="2"
                         AutomationId="ImportAudioButton"
                         Source="add.png"
                         WidthRequest="44"
                         HeightRequest="44"
                         Padding="10"
                         Background="Transparent"
                         Command="{Binding AddFileCommand}"
                         SemanticProperties.Description="{Binding AddFileLabel}" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              VerticalOptions="Center">
            <Label Text="{Binding SortLabel}"
                   VerticalOptions="Center"
                   FontSize="14" />
            <Picker Grid.Column="1"
                    AutomationId="LibrarySortPicker"
                    Title="{Binding SortLabel}"
                    ItemsSource="{Binding SortOptions}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
        </Grid>

        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{DynamicResource Error}"
               FontSize="13" />

        <Grid Grid.Row="3">
            <CollectionView AutomationId="LibraryTrackList"
                            ItemsSource="{Binding FilteredTracks}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border Margin="0,0,0,6"
                                Padding="8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{DynamicResource Surface}">
                            <Grid ColumnDefinitions="56,*,Auto,Auto"
                                  ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="56"
                                        HeightRequest="56"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{DynamicResource SurfaceAlt}">
                                    <Grid>
                                        <Label Text="♪"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               FontSize="24"
                                               TextColor="{DynamicResource Accent}" />
                                        <Image Source="{Binding ArtworkPath}"
                                               Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="3">
                                    <Label Text="{Binding Title}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           FontAttributes="Bold"
                                           FontSize="15" />
                                    <Label Text="{Binding Artist}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       TextColor="{DynamicResource TextSecondary}" />
                                <ImageButton Grid.Column="3"
                                             Source="info.png"
                                             WidthRequest="36"
                                             HeightRequest="36"
                                             Padding="8"
                                             Background="Transparent"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenDetailsCommand}"
                                             CommandParameter="{Binding .}"
                                             SemanticProperties.Description="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=TrackInfoLabel}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=PlayTrackCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24"
                                         Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{Binding EmptyMessage}"
                               HorizontalTextAlignment="Center"
                               FontSize="16" />
                        <Button Text="{Binding RescanLabel}"
                                Command="{Binding RescanCommand}"
                                HorizontalOptions="Center" />
                        <Button Text="{Binding AddFileLabel}"
                                Command="{Binding AddFileCommand}"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{DynamicResource Accent}" />
        </Grid>

        <controls:MiniPlayerView Grid.Row="4" />
    </Grid>
</ContentPage>