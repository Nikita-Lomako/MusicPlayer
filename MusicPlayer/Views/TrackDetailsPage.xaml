<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MusicPlayer.ViewModels"
             x:Class="MusicPlayer.Views.TrackDetailsPage"
             x:DataType="vm:TrackDetailsViewModel"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="16">
            <Border WidthRequest="180"
                    HeightRequest="180"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Grid>
                    <Image Source="note.png"
                           WidthRequest="64"
                           HeightRequest="64"
                           Opacity="0.35"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Image Source="{Binding ArtworkPath}"
                           Aspect="AspectFill"
                           IsVisible="{Binding HasArtwork}" />
                </Grid>
            </Border>

            <Label Text="{Binding TrackTitle}"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Button Text="{Binding PlayLabel}"
                    Command="{Binding PlayCommand}"
                    IsEnabled="{Binding HasTrack}"
                    HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding TitleLabel}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding TrackTitle}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding ArtistLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Artist}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding AlbumLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Album}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding AlbumArtistLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding AlbumArtist}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding FormatLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Format}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding BitrateLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Bitrate}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding DurationLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Duration}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding FileSizeLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding FileSize}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding YearLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Year}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding GenreLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1" Text="{Binding Genre}" HorizontalTextAlignment="End" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource SurfaceDark}}" />
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      Padding="0,8">
                    <Label Text="{Binding FilePathLabel}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Label Grid.Column="1"
                           Text="{Binding FilePath}"
                           HorizontalTextAlignment="End"
                           LineBreakMode="CharacterWrap" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
